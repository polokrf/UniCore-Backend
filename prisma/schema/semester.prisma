model Semester {
  id        String   @id @default(uuid())
  name      String
  year      Int

  startDate DateTime
  endDate   DateTime

  isActive  Boolean  @default(true)
  offerings CourseOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, year])
  @@map("semesters")
}