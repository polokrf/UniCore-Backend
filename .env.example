# Copy to .env and fill in real values. .env is gitignored, never commit it.
DATABASE_URL=postgresql://user:password@host:5432/dbname
PORT=5000
MODE=development
PASSWORD_SALT=10

ACCESS_SECRET=change-me
ACCESS_EXPIRED=1d
REFRESH_SECRET=change-me-too
REFRESH_EXPIRED=7d

SMTP_USER=
SMTP_PASSWORD=
SENDER_EMAIL=

# Redis (bKash token cache)
REDIS_HOST=
REDIS_PORT=
REDIS_USERNAME=
REDIS_PASSWORD=

CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# bKash tokenized checkout
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_API_KEY=
BKASH_API_SECRET=

# where bKash sends the customer back to (backend) and the frontend origin
CALLBACK_URL=http://localhost:5000/api/payment
APP_URL=http://localhost:3000
